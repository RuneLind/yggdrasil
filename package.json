{
  "name": "yggdrasil",
  "version": "0.1.0",
  "description": "Code intelligence engine \u2014 indexes codebases into a searchable knowledge graph with symbol extraction, call graph traversal, and blast radius analysis. Exposes tools via MCP.",
  "type": "module",
  "scripts": {
    "start": "bun run src/mcp/server.ts",
    "dev": "bun --watch src/mcp/server.ts",
    "index": "bun run src/cli.ts index",
    "embed": "bun run src/cli.ts embed",
    "search": "bun run src/cli.ts search",
    "db:migrate": "bun run scripts/migrate.ts",
    "eval:callers": "bun run scripts/eval-callers.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "postgres": "^3.4.9",
    "web-tree-sitter": "^0.26.13",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-typescript": "^0.23.2",
    "@tree-sitter-grammars/tree-sitter-kotlin": "^1.1.0",
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "protobufjs": "^7.6.6",
    "sharp": "^0.35.5"
  }
}

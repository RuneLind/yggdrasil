{
  "name": "yggdrasil",
  "version": "0.1.0",
  "description": "Code intelligence engine — indexes codebases into a searchable knowledge graph with symbol extraction, call graph traversal, and blast radius analysis. Exposes tools via MCP.",
  "type": "module",
  "scripts": {
    "start": "bun run src/mcp/server.ts",
    "dev": "bun --watch src/mcp/server.ts",
    "index": "bun run src/cli.ts index",
    "search": "bun run src/cli.ts search",
    "db:migrate": "bun run scripts/migrate.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "postgres": "^3.4.5",
    "web-tree-sitter": "^0.26.8",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-typescript": "^0.23.2",
    "@tree-sitter-grammars/tree-sitter-kotlin": "^1.1.0",
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}

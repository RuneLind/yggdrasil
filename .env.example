# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/yggdrasil

# MCP server port
YGGDRASIL_PORT=9130

# Embedding model (HuggingFace model ID, must be ONNX-compatible)
# Default: Xenova/multilingual-e5-small (384 dims, good for mixed-language codebases)
# Alternatives:
#   Xenova/all-MiniLM-L6-v2          — 384 dims, English-only, faster
#   jinaai/jina-embeddings-v2-base-code — 768 dims, code-optimized
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMS=384
